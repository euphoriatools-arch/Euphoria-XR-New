---
import type { Faq } from '../../data/types';

interface Props {
	items: Faq[];
}

const { items } = Astro.props;
---

<div class="faq">
	{
		items.map((item) => (
			<details>
				<summary>
					<h3>{item.question}</h3>
				</summary>
				<div class="answer">
					<p>{item.answer}</p>
				</div>
			</details>
		))
	}
</div>
