---
interface Props {
	id?: string;
	label?: string;
	title?: string;
	intro?: string;
	class?: string;
}

const { id, label, title, intro, class: className } = Astro.props;
---

<section id={id} class:list={['section', className]} data-reveal>
	<div class="section-inner">
		{label && <p class="section-label">{label}</p>}
		{title && <h2>{title}</h2>}
		{intro && <p class="lede">{intro}</p>}
		<slot />
	</div>
</section>
