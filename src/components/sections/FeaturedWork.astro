---
import { Image } from 'astro:assets';
import { featuredWork } from '../../data/home';
import { photoFor } from '../../data/images';
---

<section class="section" id="work">
	<div class="section-inner">
		<div class="section-head">
			<h2 class="section-label">Featured work</h2>
			<a class="text-link" href="/contact/">Start a similar project <span aria-hidden="true">↗</span></a>
		</div>
		<p class="note">Project names below are illustrative placeholders until verified case studies are published.</p>
		<div class="work-grid">
			{
				featuredWork.map((project, index) => (
					<article class="project">
						<div class="project-image">
							<Image src={photoFor(project.image)} alt={project.alt} loading="lazy" widths={[480, 800, 1200]} sizes="(min-width: 800px) 33vw, 100vw" />
						</div>
						<p class="project-meta">{project.meta}</p>
						<h3>{project.title}</h3>
						<p>{project.body}</p>
						<div class="project-foot">
							<button type="button" data-project={project.title} data-description={project.detail}>
								View project <span aria-hidden="true">→</span>
							</button>
							<span class="number">0{index + 1} / 0{featuredWork.length}</span>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<dialog class="dialog" id="project-dialog" aria-labelledby="project-dialog-title">
	<div class="dialog-box">
		<button class="dialog-close" type="button" data-close aria-label="Close dialog">×</button>
		<p class="eyebrow">Project preview</p>
		<h2 id="project-dialog-title">Project</h2>
		<p id="project-dialog-body"></p>
		<p><strong>Prototype note:</strong> Project names, imagery, and descriptions are illustrative placeholders. Replace them with verified EuphoriaXR portfolio content.</p>
		<a class="outline-btn" href="/contact/">Discuss a similar project <span class="arrow" aria-hidden="true">↗</span></a>
	</div>
</dialog>

<script>
	function initProjects() {
		const dialog = document.querySelector<HTMLDialogElement>('#project-dialog');
		const title = document.querySelector('#project-dialog-title');
		const body = document.querySelector('#project-dialog-body');
		if (!dialog || !title || !body || dialog.dataset.bound === 'true') return;
		dialog.dataset.bound = 'true';
		document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach((button) => {
			button.addEventListener('click', () => {
				title.textContent = button.dataset.project ?? '';
				body.textContent = button.dataset.description ?? '';
				dialog.showModal();
			});
		});
		dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}

	document.addEventListener('astro:page-load', initProjects);
	initProjects();
</script>
