---
import ContactBand from '../studio/ContactBand.astro';
import BlogCard from './BlogCard.astro';
import {
	blogAuthor,
	categoryHref,
	formatBlogDate,
	nextPost,
	relatedPosts,
	tocLinks,
	type BlogPost,
} from '../../lib/blog';
import { absoluteUrl } from '../../lib/urls';
import '../../styles/case.css';
import '../../styles/blog.css';

interface Props {
	post: BlogPost;
}

const { post } = Astro.props;
const pageUrl = absoluteUrl(`/${post.slug}/`);
const shareText = encodeURIComponent(post.title);
const shareLinks = [
	{ label: 'Share on X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${shareText}` },
	{ label: 'Share on Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}` },
	{ label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}` },
];
const topicHref = categoryHref(post.primaryCategory);
const next = nextPost(post);
const related = relatedPosts(post);
const toc = tocLinks(post);
---

<article class="cs-detail bl-post">
	<div class="cs-hero-card bl-hero-card">
		<div class="cs-hero-main bl-hero-main">
			<div class="bl-hero-copy">
				<p class="bl-kicker">
					{topicHref ? <a class="bl-cat" href={topicHref}>{post.primaryCategory}</a> : <span class="bl-cat">{post.primaryCategory}</span>}
					<span class="bl-read">{post.readingTime} min read</span>
				</p>
				<h1>{post.title}</h1>
				<div class="cs-share bl-share">
					<span class="bl-share-label">Share</span>
					{
						shareLinks.map((link) => (
							<a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
								{link.label === 'Share on X' ? (
									<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
										<path d="M14.7 10.3 22 2h-2.2l-6.1 7-4.9-7H2.2l7.7 11.1L2 22h2.2l6.7-7.7 5.3 7.7h6.6l-8.1-11.7Zm-2.4 2.7-.8-1.1L5.2 3.6h2.7l5 7.1.8 1.1 6.5 9.2h-2.7l-5.2-7z" />
									</svg>
								) : link.label === 'Share on LinkedIn' ? (
									<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
										<path d="M4.7 3.3A1.8 1.8 0 1 0 4.7 7a1.8 1.8 0 0 0 0-3.7ZM3.2 8.6h3V21h-3V8.6Zm5.1 0h2.9v1.7h.1c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.7 2 3.7 4.7V21h-3v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-3V8.6Z" />
									</svg>
								) : (
									<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
										<path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1Z" />
									</svg>
								)}
							</a>
						))
					}
					<button type="button" data-bl-copy aria-label="Copy link">
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
							<rect x="8" y="8" width="12" height="12" rx="2" />
							<path d="M4 16V6a2 2 0 0 1 2-2h10" />
						</svg>
					</button>
				</div>
			</div>
			<span class="bl-cover">
				<img class="cs-cover bl-cover-img" src={post.image} alt={`Cover image for ${post.title}`} width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
			</span>
		</div>
		<div class="cs-meta bl-meta">
			<div>
				<p class="cs-date">{formatBlogDate(post.date)}</p>
				{related.length > 0 && <a class="cs-related-jump" href="#related">Related <span aria-hidden="true">⌄</span></a>}
			</div>
			{
				next && (
					<a class="cs-next" href={`/${next.slug}/`}>
						<span>
							<small>Read next article.</small>
							<strong>{next.title}</strong>
						</span>
						<span class="cs-next-btn" aria-hidden="true">›</span>
					</a>
				)
			}
		</div>
	</div>

	<div class="post-layout">
		{
			toc.length > 0 && (
				<div class="post-toc">
					<details class="post-toc-fold">
						<summary>On this page ⌄</summary>
						<nav aria-label="On this page">
							<ol>
								{toc.map((item) => (
									<li>
										<a href={`#${item.id}`}>{item.label}</a>
									</li>
								))}
							</ol>
						</nav>
					</details>
					<nav class="post-toc-card" aria-label="On this page">
						<p>On this page</p>
						<ol>
							{toc.map((item) => (
								<li>
									<a href={`#${item.id}`}>{item.label}</a>
								</li>
							))}
						</ol>
					</nav>
				</div>
			)
		}
		<div class="post-article">
			<div class="bl-prose" set:html={post.html} />
			<div class="bl-author">
				<img src={blogAuthor.avatar} alt="" width="64" height="64" />
				<p><a rel="author" href="/exr-blogs/">{post.author}</a></p>
				<p>{post.authorRole}</p>
			</div>
		</div>
	</div>
</article>

{
	related.length > 0 && (
		<section class="cs-related" id="related" aria-roledescription="carousel" aria-labelledby="related-articles-title">
			<div class="cs-related-head">
				<h2 id="related-articles-title">Related Articles</h2>
				{related.length >= 3 && (
					<button class="cs-related-next" type="button" data-bl-next aria-label="Next article">
						›
					</button>
				)}
			</div>
			<div class={related.length >= 3 ? 'swiper' : 'bl-related-grid'} data-bl-related={related.length >= 3 ? 'swiper' : 'static'}>
				<div class={related.length >= 3 ? 'swiper-wrapper' : undefined}>
					{related.map((item) => (
						<div class={related.length >= 3 ? 'swiper-slide' : undefined}>
							<BlogCard post={item} dark />
						</div>
					))}
				</div>
			</div>
		</section>
	)
}
<ContactBand id="blog-contact-title" />

<script>
	import Swiper from 'swiper';
	import { Autoplay, Navigation } from 'swiper/modules';

	let relatedSwiper: Swiper | undefined;

	function bindBlogPost() {
		document.querySelectorAll<HTMLButtonElement>('[data-bl-copy]').forEach((button) => {
			if (button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';
			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(window.location.href);
					button.setAttribute('aria-label', 'Link copied');
				} catch {
					button.setAttribute('aria-label', 'Copy the address from the browser bar');
				}
			});
		});

		const links = [...document.querySelectorAll<HTMLAnchorElement>('.post-toc a')];
		if (links.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const ids = [...new Set(links.map((link) => link.getAttribute('href')?.slice(1)).filter((id): id is string => Boolean(id)))];
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						for (const link of links) {
							if (link.getAttribute('href') === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
							else link.removeAttribute('aria-current');
						}
					}
				},
				{ rootMargin: '-20% 0px -70% 0px' },
			);
			for (const id of ids) {
				const heading = document.getElementById(id);
				if (heading) observer.observe(heading);
			}
		}

		relatedSwiper?.destroy(true, true);
		relatedSwiper = undefined;
		const root = document.querySelector<HTMLElement>('[data-bl-related="swiper"]');
		if (!root) return;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		relatedSwiper = new Swiper(root, {
			modules: [Autoplay, Navigation],
			slidesPerView: 1.2,
			spaceBetween: 16,
			speed: 300,
			loop: !reduce,
			autoplay: reduce ? false : { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
			navigation: { nextEl: '[data-bl-next]' },
			breakpoints: {
				768: { slidesPerView: 2.2, spaceBetween: 24 },
				1024: { slidesPerView: 2.5, spaceBetween: 30 },
			},
		});
	}

	bindBlogPost();
	document.addEventListener('astro:page-load', () => bindBlogPost());
	document.addEventListener('astro:before-swap', () => {
		relatedSwiper?.destroy(true, true);
		relatedSwiper = undefined;
	});
</script>
