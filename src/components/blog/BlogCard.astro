---
import { formatBlogDate, visibleCategories, type BlogPost } from '../../lib/blog';

interface Props {
	post: BlogPost;
	dark?: boolean;
	eager?: boolean;
}

const { post, dark = false, eager = false } = Astro.props;
const categories = visibleCategories(post.categories);
---

<a class:list={['bl-card', dark && 'is-dark']} href={`/${post.slug}/`}>
	<span class="bl-card-media">
		<img
			src={post.image}
			alt={`Cover image for ${post.title}`}
			width="1920"
			height="1080"
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
	</span>
	<span class="bl-card-body">
		{categories.length > 0 && <span class="bl-card-cat">{categories.join(', ')}</span>}
		<h3>{post.title}</h3>
		<span class="bl-card-foot">
			<time datetime={post.date.slice(0, 10)}>{formatBlogDate(post.date)}</time>
			<span class="bl-eye" aria-hidden="true">
				<svg viewBox="0 0 25 16" fill="none">
					<path d="M1 8s4.2-7 11.5-7S24 8 24 8s-4.2 7-11.5 7S1 8 1 8Z" stroke="currentColor" stroke-width="1.6" />
					<circle cx="12.5" cy="8" r="3" stroke="currentColor" stroke-width="1.6" />
				</svg>
			</span>
		</span>
	</span>
</a>
