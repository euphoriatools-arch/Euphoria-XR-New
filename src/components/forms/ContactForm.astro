---
import { site } from '../../config/site';
import { hearAboutOptions, panelInterestOptions } from '../../lib/contact';

interface Props {
	/** @deprecated Panel is the only layout now. Kept so existing callers keep working. */
	layout?: 'stack' | 'panel';
}

const { layout: _layout = 'panel' } = Astro.props;
void _layout;
---

<form
	id="contact-form"
	class="form-grid cx-form"
	action={site.form.endpoint}
	method="post"
	novalidate
	data-astro-reload
>
	<fieldset class="cx-interest">
		<legend>I'm interested in...</legend>
		<div class="cx-chips">
			{
				panelInterestOptions.map((option) => (
					<label class="cx-chip">
						<input type="radio" name="service" value={option.value} required />
						<span>{option.label}</span>
					</label>
				))
			}
		</div>
		<p class="error" data-error-for="service" hidden />
	</fieldset>
	<div class="cx-fields">
		<div class="cx-split">
			<div class="field">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" />
				<p class="error" data-error-for="name" hidden />
			</div>
			<div class="field">
				<label for="company">Company</label>
				<input id="company" name="company" type="text" autocomplete="organization" maxlength="120" />
				<p class="error" data-error-for="company" hidden />
			</div>
		</div>
		<div class="cx-split">
			<div class="field">
				<label for="email">Email</label>
				<input id="email" name="email" type="email" autocomplete="email" required maxlength="120" />
				<p class="error" data-error-for="email" hidden />
			</div>
			<div class="field">
				<label for="phone">Phone Number</label>
				<input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
				<p class="error" data-error-for="phone" hidden />
			</div>
		</div>
		<div class="field">
			<label for="hear_about">How did you hear about us?</label>
			<select id="hear_about" name="hear_about">
				<option value="">Select an option</option>
				{
					hearAboutOptions.map((option) => (
						<option value={option.value}>{option.label}</option>
					))
				}
			</select>
			<p class="error" data-error-for="hear_about" hidden />
		</div>
		<div class="field">
			<label for="message">Message</label>
			<textarea id="message" name="message" required minlength="20" maxlength="5000" />
			<p class="error" data-error-for="message" hidden />
		</div>
	</div>
	<div class="hp" aria-hidden="true">
		<label for="company_website">Website</label>
		<input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
	</div>
	<button class="outline-btn" type="submit">Submit</button>
	<p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
	import { isHoneypotTripped, readContactPayload, validateContact } from '../../lib/contact';

	function initContactForm() {
		const form = document.querySelector<HTMLFormElement>('#contact-form');
		if (!form || form.dataset.bound === 'true') return;
		form.dataset.bound = 'true';
		const status = form.querySelector<HTMLElement>('.form-status');
		const fields = ['name', 'email', 'company', 'phone', 'service', 'hear_about', 'message'] as const;

		const controls = (field: string) => {
			const item = form.elements.namedItem(field);
			if (item instanceof RadioNodeList) return [...item].filter((el): el is HTMLInputElement => el instanceof HTMLInputElement);
			return item instanceof HTMLElement ? [item] : [];
		};

		const showErrors = (errors: Partial<Record<(typeof fields)[number], string>>) => {
			for (const field of fields) {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
				const inputs = controls(field);
				if (!slot) continue;
				const message = errors[field];
				slot.hidden = !message;
				slot.textContent = message ?? '';
				for (const input of inputs) {
					if (message) input.setAttribute('aria-invalid', 'true');
					else input.removeAttribute('aria-invalid');
				}
			}
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const payload = readContactPayload(Object.fromEntries(data.entries()));
			if (isHoneypotTripped(payload)) {
				if (status) status.textContent = 'Thanks. We have your note.';
				form.reset();
				return;
			}
			const errors = validateContact(payload);
			showErrors(errors);
			if (Object.keys(errors).length > 0) {
				if (status) status.textContent = 'Check the highlighted fields and try again.';
				const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
				firstInvalid?.focus();
				return;
			}
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (button) button.disabled = true;
			if (status) status.textContent = 'Sending…';
			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'content-type': 'application/json', accept: 'application/json' },
					body: JSON.stringify(payload),
				});
				const body = (await response.json()) as { ok?: boolean; message?: string; errors?: typeof errors };
				if (body.errors) showErrors(body.errors);
				if (status) status.textContent = body.message || (response.ok ? 'Thanks. We have your note.' : 'Something went wrong. Please email us.');
				if (body.ok) form.reset();
			} catch {
				if (status) status.textContent = 'The form could not be sent. Please email the studio directly.';
			} finally {
				if (button) button.disabled = false;
			}
		});
	}

	document.addEventListener('astro:page-load', initContactForm);
	initContactForm();
</script>
