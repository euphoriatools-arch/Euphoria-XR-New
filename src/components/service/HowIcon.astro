---
import type { HowWeWorkIcon } from '../../data/howWeWork';

interface Props {
	name: HowWeWorkIcon;
}

const { name } = Astro.props;
---

<svg class="svc-how-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
	{
		name === 'trophy' && (
			<path
				d="M8 4h8v3a4 4 0 0 1-4 4 4 4 0 0 1-4-4Zm0 0H5a2 2 0 0 0 2 4M16 4h3a2 2 0 0 1-2 4M12 11v3M9 20h6M10 17h4"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		)
	}
	{
		name === 'speed' && (
			<path
				d="M5 16a8 8 0 1 1 14 0M12 16l4-5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		)
	}
	{
		name === 'delivery' && (
			<path
				d="M3 8h11v10H3Zm11 3h4l3 3v4h-7Zm2.5 7.5h.01M7 18.5h.01"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		)
	}
	{
		name === 'code' && (
			<path
				d="m8 8-4 4 4 4M16 8l4 4-4 4M13 6l-2 12"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		)
	}
	{
		name === 'partnership' && (
			<path
				d="M8.5 13.5 7 15a3 3 0 0 0 4.2 4.2l1.3-1.3M15.5 10.5 17 9a3 3 0 0 0-4.2-4.2L11.5 6M9.5 14.5l5-5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		)
	}
</svg>
