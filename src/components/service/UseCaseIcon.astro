---
import type { UseCaseIcon } from '../../data/useCaseCatalogs';

interface Props {
	name: UseCaseIcon;
}

const { name } = Astro.props;
---

<svg class="svc-use-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
	{
		name === 'training' && (
			<>
				<circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M5 19c1.5-3 3.8-4.5 7-4.5S17.5 16 19 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			</>
		)
	}
	{name === 'simulation' && <path d="M4 9h16v10H4Zm3-3h10v3H7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'design' && <path d="M12 3 4 8v8l8 5 8-5V8Zm0 5v10M4 8l8 5 8-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'guided' && <path d="M5 7h14M5 12h9M5 17h6M16 14l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{
		name === 'collab' && (
			<>
				<circle cx="8" cy="8" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<circle cx="16" cy="8" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M4 19c1-2.5 2.8-3.8 5-3.8h1c1.3 0 2.4.5 3.3 1.3M14 15.5c1-.6 2.2-1 3.6-1 2 0 3.8 1.1 4.4 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			</>
		)
	}
	{name === 'customer' && <path d="M7 8h10l-1 11H8Zm2-3h6l1 3H8Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'medical' && <path d="M9 4h6v5h5v6h-5v5H9v-5H4V9h5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'research' && <path d="M9 3h6v5l-2.5 4.5V19l-1.5 2-1.5-2v-6.5L9 8Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'education' && <path d="M3 10 12 5l9 5-9 5Zm0 0v6l9 4 9-4v-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'data' && <path d="M6 19V10m6 9V5m6 14v-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>}
	{name === 'productivity' && <path d="M5 19 12 5l7 14M9 13h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'rnd' && <path d="M9 3h6l-1 7h4L12 21l-1-7H7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'robotics' && <path d="M9 6h6v4H9Zm-1 4h8v7H8Zm2 10h4M10 13h.01M14 13h.01" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'fitness' && <path d="M7 8v8M17 8v8M7 10h10M7 14h10M4 10v4M20 10v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>}
	{name === 'wellness' && <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.6-7 10-7 10Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'entertainment' && <path d="M4 8h16v9H4Zm4 9 1.5 3M16 17l-1.5 3M9 12h.01M15 12h.01" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'gaming' && <path d="M7 10h10a3 3 0 0 1 3 3v2a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-2a3 3 0 0 1 3-3Zm2 2v3M8.5 13.5h3M15.5 12.5h.01M17.5 14.5h.01" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'art' && <path d="M5 19 13.5 5.5 19 9 10.5 22.5Zm8.5-13.5 2.5 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'tours' && <path d="M3 9h18v9H3Zm4 3h4v3H7Zm8-1h2m-2 3h2M2 20h20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'events' && <path d="M8 5v3M16 5v3M5 10h14v9H5Zm0-2h14V8a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'marketing' && <path d="M4 9v6l11 3V6Zm11 0 5-2v12l-5-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'heritage' && <path d="M4 20h16M6 20V11h12v9M12 4 5 9h14Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{
		name === 'therapy' && (
			<>
				<circle cx="12" cy="9" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M12 12.5V19M9 19h6M5 8 3.5 6.5M19 8l1.5-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			</>
		)
	}
	{
		name === 'presence' && (
			<>
				<circle cx="8" cy="8" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<circle cx="16" cy="8" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M3.5 19c1.2-2.4 3-3.7 5.2-3.7h1.2c1.2 0 2.3.5 3.1 1.2M14 15.7c1-.5 2.1-.8 3.4-.8 2.1 0 3.9 1.1 5.1 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			</>
		)
	}
	{name === 'support' && <path d="M5 12a7 7 0 0 1 14 0v4a2 2 0 0 1-2 2h-2v-5h4M5 12v4a2 2 0 0 0 2 2h2v-5H5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'onboarding' && <path d="M12 4v9m0 0 3-3m-3 3-3-3M5 16v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'knowledge' && <path d="M5 5h6a3 3 0 0 1 3 3v11l-3-1.8L8 19V8a3 3 0 0 0-3-3Zm8 0h6v14l-3-1.8L13 19Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'routing' && <path d="M5 7h6l2 3h6M7 7v10m10-7v7M5 17h4m6 0h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'review' && <path d="M5 5h14v14H5Zm3 5h8M8 14h5m2 0 2 2 3-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>}
	{name === 'integration' && <path d="M7 7h3v3H7Zm7 0h3v3h-3ZM7 14h3v3H7Zm7 0h3v3h-3ZM10 10v4m4-4v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{
		name === 'agent' && (
			<>
				<path d="M9 8a3 3 0 0 1 6 0v1h1.5A1.5 1.5 0 0 1 18 10.5V16H6v-5.5A1.5 1.5 0 0 1 7.5 9H9Zm0 11h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
				<circle cx="10" cy="12.5" r="0.8" fill="currentColor"></circle>
				<circle cx="14" cy="12.5" r="0.8" fill="currentColor"></circle>
			</>
		)
	}
	{name === 'filter' && <path d="M4 6h16l-6 7v5l-4 2v-7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{name === 'packaging' && <path d="M4 8 12 4l8 4v8l-8 4-8-4Zm0 0 8 4 8-4M12 12v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{
		name === 'tryon' && (
			<>
				<path d="M8.5 10.5c0-2 1.6-3.5 3.5-3.5s3.5 1.5 3.5 3.5c0 2.6-3.5 6-3.5 6s-3.5-3.4-3.5-6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
				<path d="M16.5 8.5 19 7M7.5 8.5 5 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			</>
		)
	}
	{name === 'config' && <path d="M4 6h7v5H4Zm9 0h7v12h-7ZM4 13h7v5H4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>}
	{
		name === 'mint' && (
			<>
				<circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M12 3v2.5M12 18.5V21M4.8 6.3l1.8 1.8M17.4 15.9l1.8 1.8M3 12h2.5M18.5 12H21M4.8 17.7l1.8-1.8M17.4 8.1l1.8-1.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			</>
		)
	}
	{name === 'world' && <path d="M12 4a8 8 0 1 0 8 8 8 8 0 0 0-8-8Zm-8 8h16M12 4c2.2 2.4 2.2 11.6 0 16M12 4c-2.2 2.4-2.2 11.6 0 16" fill="none" stroke="currentColor" stroke-width="1.6"></path>}
</svg>
