---
import { homeFaqs } from '../../data/home';

const leftFaqs = homeFaqs.slice(0, 5);
const rightFaqs = homeFaqs.slice(5, 10);
---

<section class="hx-section hx-faq" id="faq" aria-labelledby="faq-title">
	<div class="hx-wrap">
		<div class="hx-faq-head">
			<h2 id="faq-title">FAQ.</h2>
			<p>Got questions? We’ve got answers. Here’s everything you need to know about working with us.</p>
		</div>

		<div class="hx-faq-columns">
			<div class="hx-faq-list">
				{
					leftFaqs.map((faq) => (
						<details class="hx-faq-item">
							<summary>
								<span>{faq.question}</span>
								<span class="hx-faq-toggle" aria-hidden="true"></span>
							</summary>
							<p>{faq.answer}</p>
						</details>
					))
				}
			</div>
			<div class="hx-faq-list">
				{
					rightFaqs.map((faq) => (
						<details class="hx-faq-item">
							<summary>
								<span>{faq.question}</span>
								<span class="hx-faq-toggle" aria-hidden="true"></span>
							</summary>
							<p>{faq.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>
