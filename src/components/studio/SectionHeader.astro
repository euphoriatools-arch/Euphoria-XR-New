---
interface Props {
	eyebrow?: string;
	title: string;
	id: string;
	href?: string;
	linkLabel?: string;
}

const { eyebrow, title, id, href, linkLabel } = Astro.props;
---

<div class="studio-section-head">
	<div>
		{eyebrow && <p class="studio-eyebrow">{eyebrow}</p>}
		<h2 id={id}>{title}</h2>
	</div>
	{
		href && linkLabel && (
			<a class="studio-text-link" href={href}>
				{linkLabel}
				<span aria-hidden="true">→</span>
			</a>
		)
	}
</div>
