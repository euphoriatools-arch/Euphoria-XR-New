---
import { Image } from 'astro:assets';
import { featuredWork } from '../../data/home';
import { photoFor } from '../../data/images';
---

<div class="studio-carousel" data-carousel>
	<div class="studio-carousel-bar">
		<div class="slider-controls">
			<button type="button" data-carousel-prev aria-label="Previous featured work">←</button>
			<button type="button" data-carousel-next aria-label="Next featured work">→</button>
		</div>
	</div>
	<div class="studio-scroller" tabindex="0" aria-label="Featured work">
		{
			featuredWork.map((item) => (
				<article class="studio-concept">
					<div class="studio-concept-media">
						<Image
							src={photoFor(item.image)}
							alt={item.alt}
							widths={[480, 800, 1200]}
							sizes="(min-width: 1024px) 40vw, 86vw"
							loading="lazy"
						/>
					</div>
					<div class="studio-concept-copy">
						<p class="studio-kicker">{item.meta}</p>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</div>
				</article>
			))
		}
	</div>
</div>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function bindCarousel(root: HTMLElement) {
		if (root.dataset.bound === 'true') return;
		const scroller = root.querySelector<HTMLElement>('.studio-scroller');
		const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		if (!scroller || !prev || !next) return;
		root.dataset.bound = 'true';

		const amount = () => {
			const card = scroller.querySelector<HTMLElement>('.studio-concept');
			return (card?.getBoundingClientRect().width ?? 320) + 18;
		};

		const move = (direction: number) => {
			scroller.scrollBy({
				left: direction * amount(),
				behavior: reduceMotion.matches ? 'auto' : 'smooth',
			});
		};

		prev.addEventListener('click', () => move(-1));
		next.addEventListener('click', () => move(1));

		scroller.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				move(1);
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault();
				move(-1);
			}
		});
	}

	function initCarousels() {
		document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(bindCarousel);
	}

	initCarousels();
	document.addEventListener('astro:page-load', initCarousels);
</script>
