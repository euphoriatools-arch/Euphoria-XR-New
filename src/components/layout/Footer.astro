---
import { site } from '../../config/site';
import { industryPages } from '../../data/industries';
import { servicePages } from '../../data/services';

const year = new Date().getFullYear();
const company = [
	{ href: '/about/', label: 'About EuphoriaXR' },
	{ href: '/portfolio/', label: 'Case studies' },
	{ href: '/contact/', label: 'Contact the studio' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/privacy-policy/', label: 'Privacy policy' },
	{ href: '/terms/', label: 'Terms of use' },
];
---

<footer class="site-footer">
	<div class="footer-grid">
		<div>
			<a class="logo" href="/">
				<img src="/brand/logo-dark.svg" alt="EuphoriaXR logo" width="168" height="28" />
			</a>
			<p class="footer-blurb">
				{site.siteName} builds immersive AR, VR, AI, and 3D experiences for teams who need the work shipped.
			</p>
		</div>
		<div>
			<h2>Services</h2>
			<ul>
				{
					servicePages.map((page) => (
						<li>
							<a href={`/${page.slug}/`}>{page.navLabel}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h2>Industries</h2>
			<ul>
				{
					industryPages.map((page) => (
						<li>
							<a href={`/${page.slug}/`}>{page.navLabel}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h2>Company</h2>
			<ul>
				{
					company.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
			<div class="socials">
				<a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
				<a href={site.social.instagram} target="_blank" rel="noopener noreferrer">Instagram<span class="sr-only"> (opens in a new tab)</span></a>
			</div>
		</div>
	</div>
	<div class="footer-band">
		<div class="footer-mark" aria-hidden="true">
			<p class="footer-wordmark">{site.siteName.toUpperCase()}</p>
		</div>
		<p class="footer-legal">Copyright © {site.copyrightStartYear} – {year} {site.legalName}</p>
	</div>
</footer>
