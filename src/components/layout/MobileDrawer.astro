---
import { navigation, type NavGroup, type NavLink } from '../../config/navigation';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;

const sections: { id: string; label: string; groups?: NavGroup[]; links?: NavLink[] }[] = [
	{ id: 'drawer-services', label: 'Services', groups: navigation.services },
	{ id: 'drawer-industries', label: 'Industries', groups: navigation.industries },
	{ id: 'drawer-company', label: 'Company', links: navigation.company },
];
---

<div class="drawer" id="site-drawer" aria-hidden="true">
	<div class="drawer-bar">
		<a class="logo" href="/">
			<img src="/brand/logo-dark.webp" alt="EuphoriaXR logo" width="210" height="28" />
		</a>
		<button class="drawer-close" type="button">Close menu</button>
	</div>
	<div class="drawer-body">
		{
			sections.map((section) => (
				<div class="acc">
					<button class="acc-trigger" type="button" aria-expanded="false" aria-controls={section.id}>
						{section.label}
					</button>
					<div class="acc-panel" id={section.id}>
						<div class="acc-inner">
							{section.groups?.map((group) => (
								<div class="drawer-group">
									<p class="mega-label">{group.title}</p>
									<ul>
										{group.links.map((link) => (
											<li>
												<a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>
													<span>{link.label}</span>
													<small>{link.description}</small>
												</a>
											</li>
										))}
									</ul>
								</div>
							))}
							{section.links && (
								<ul>
									{section.links.map((link) => (
										<li>
											<a href={link.href} aria-current={link.href === '/portfolio/' ? (pathname.startsWith('/portfolio/') ? 'page' : undefined) : pathname === link.href ? 'page' : undefined}>
												<span>{link.label}</span>
												<small>{link.description}</small>
											</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</div>
				</div>
			))
		}
		<a
			class="drawer-link"
			href={navigation.blog.href}
			aria-current={pathname === navigation.blog.href ? 'page' : undefined}
		>
			{navigation.blog.label}
		</a>
	</div>
	<a class="btn-primary drawer-cta" href={navigation.drawerCta.href}>{navigation.drawerCta.label}</a>
</div>
