---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/studio/ContactBand.astro';
import WorkCard from '../components/studio/WorkCard.astro';
import { categories } from '../content/categories';
import { heroSlides } from '../data/home';
import { photos } from '../data/images';
import { studioGroups, type StudioLink } from '../data/studio-links';
import { loadProjects } from '../lib/portfolio';

const projects = await loadProjects();
const featured = projects.slice(0, 16);
const latest = projects.filter((project) => !project.data.featured).slice(0, 12);
const filters = categories.filter((category) => latest.some((project) => project.data.category === category.slug));

const heroFrames = [photos.vr, photos.city, photos.abstract, photos.cosmos];
const slides = [
	{
		lines: heroSlides[0].lines,
		href: '#work',
		cta: heroSlides[0].cta,
		image: heroFrames[0],
		heading: true,
	},
	{
		lines: heroSlides[2].lines,
		href: '/ai-development-company/',
		cta: 'AI development company',
		image: heroFrames[1],
		heading: false,
	},
	{
		lines: heroSlides[1].lines,
		href: '#capabilities',
		cta: heroSlides[1].cta,
		image: heroFrames[2],
		heading: false,
	},
	{
		lines: [[{ text: "Have a project? We'd love to help." }]],
		href: '#contact',
		cta: 'Get in touch',
		image: heroFrames[3],
		heading: false,
	},
];

const solutionRows: StudioLink[] = [
	{ href: '/services/augmented-reality-development-company/', label: 'Augmented reality development company' },
	{ href: '/services/virtual-reality-development-company/', label: 'Virtual reality development company' },
	{ href: '/ai-chatbot-development-services/', label: 'AI chatbot development services' },
	{ href: '/webar-development/', label: 'WebAR development' },
	{ href: '/product-configurator/', label: '3D product configurator' },
	{ href: '/ar-vr-training-education/', label: 'VR for education / AR & VR training' },
	{ href: '/services/branded-ar-filters/', label: 'Branded AR filters' },
];
const solutionHrefs = new Set(solutionRows.map((row) => row.href));
---

<BaseLayout overlayHeader>
	<div class="hx-home">
		<section class="hx-hero-frame" aria-roledescription="carousel" aria-label="Studio">
			<div class="swiper" data-hero-swiper>
				<div class="swiper-wrapper">
					{
						slides.map((slide, index) => (
							<article class="swiper-slide hx-slide">
								<Image
									src={slide.image}
									alt=""
									widths={[800, 1280, 1800]}
									sizes="100vw"
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : 'low'}
								/>
								<div class="hx-slide-copy">
									{slide.heading ? (
										<h1 id="home-title" class="hx-display">
											{slide.lines.map((line) => (
												<span class="line">
													{line.map((part) => (
														<span class:list={[{ accent: part.accent }]}>{part.text}</span>
													))}
												</span>
											))}
										</h1>
									) : (
										<p class="hx-display">
											{slide.lines.map((line) => (
												<span class="line">
													{line.map((part) => (
														<span class:list={[{ accent: part.accent }]}>{part.text}</span>
													))}
												</span>
											))}
										</p>
									)}
									<a class="btn-primary" href={slide.href}>{slide.cta}</a>
								</div>
							</article>
						))
					}
				</div>
				<div class="swiper-pagination" data-hero-pagination></div>
			</div>
		</section>

		<section class="hx-section hx-featured" id="work" aria-labelledby="work-title">
			<div class="hx-wrap">
				<div class="hx-head">
					<div class="hx-title-row">
						<h2 id="work-title">Featured case studies</h2>
						<button class="hx-icon-btn" type="button" data-featured-next aria-label="Next featured case study">›</button>
					</div>
				</div>
				<div class="swiper" data-featured-swiper>
					<div class="swiper-wrapper">
						{featured.map((project) => <WorkCard project={project} slide />)}
					</div>
				</div>
			</div>
		</section>

		<section class="hx-section" aria-labelledby="latest-title">
			<div class="hx-wrap">
				<div class="hx-head">
					<h2 id="latest-title">Latest work</h2>
					<div class="hx-tools">
						<label class:list={['hx-search']}>
							<button class="hx-icon-btn" type="button" data-search-toggle aria-expanded="false" aria-controls="work-search">Search</button>
							<span class="sr-only">Search work</span>
							<input id="work-search" type="search" placeholder="Search" data-work-search autocomplete="off" />
						</label>
						<a class="hx-text-link" href="/portfolio/">View all</a>
					</div>
				</div>
				<div class="hx-filters" role="toolbar" aria-label="Filter work">
					<button type="button" data-work-filter="all" aria-pressed="true">All</button>
					{
						filters.map((category) => (
							<button type="button" data-work-filter={category.slug} aria-pressed="false">{category.tab}</button>
						))
					}
				</div>
				<div class="hx-grid">
					{latest.map((project) => <WorkCard project={project} />)}
				</div>
				<p class="hx-empty" data-work-empty hidden>Nothing matches that filter.</p>
			</div>
		</section>

		<section class="hx-section hx-solutions" id="capabilities" aria-labelledby="solutions-title">
			<div class="hx-wrap">
				<h2 id="solutions-title">Solutions and capabilities</h2>
				<div class="hx-stage">
					<Image
						src={photos.vr}
						alt=""
						widths={[800, 1280, 1800]}
						sizes="100vw"
						loading="lazy"
					/>
					<p>We develop across the latest platforms.</p>
				</div>
				<div class="swiper" data-solution-swiper>
					<div class="swiper-wrapper">
						{
							solutionRows.map((row) => (
								<a class="swiper-slide hx-solution" href={row.href}>{row.label}</a>
							))
						}
					</div>
				</div>
				<div class="hx-solution-nav">
					<p class="hx-caption">Each of these is a service we already ship, from the first prototype through launch.</p>
					<div>
						<button class="hx-icon-btn" type="button" data-solution-prev aria-label="Previous solution">‹</button>
						<button class="hx-icon-btn" type="button" data-solution-next aria-label="Next solution">›</button>
					</div>
				</div>
				<div class="hx-catalog">
					{
						studioGroups.map((group) => {
							const links = group.links.filter((link) => !solutionHrefs.has(link.href));
							if (links.length === 0) return null;
							return (
								<div>
									<h3>{group.title}</h3>
									<ul>
										{links.map((link) => (
											<li>
												<a href={link.href}>{link.label}</a>
											</li>
										))}
									</ul>
								</div>
							);
						})
					}
				</div>
			</div>
		</section>
	</div>
	<ContactBand />
</BaseLayout>

<script>
	import Swiper from 'swiper';
	import { Autoplay, Navigation, Pagination } from 'swiper/modules';

	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	const autoplay = motion.matches || saveData;

	let hero: Swiper | undefined;
	let featuredSwiper: Swiper | undefined;
	let solutionSwiper: Swiper | undefined;

	function destroySwipers() {
		hero?.destroy(true, true);
		featuredSwiper?.destroy(true, true);
		solutionSwiper?.destroy(true, true);
		hero = undefined;
		featuredSwiper = undefined;
		solutionSwiper = undefined;
	}

	function mountHero() {
		const root = document.querySelector<HTMLElement>('[data-hero-swiper]');
		if (!root || root.classList.contains('swiper-initialized')) return;
		hero = new Swiper(root, {
			modules: [Autoplay, Pagination],
			slidesPerView: 1,
			loop: true,
			speed: motion.matches ? 0 : 300,
			autoplay: autoplay ? false : { delay: 6000, disableOnInteraction: false },
			pagination: {
				el: '[data-hero-pagination]',
				clickable: true,
			},
			keyboard: { enabled: true, onlyInViewport: true },
			on: {
				init() {
					const titles = root.querySelectorAll('#home-title');
					titles.forEach((title, index) => {
						if (index > 0) title.removeAttribute('id');
					});
				},
			},
		});
	}

	function mountFeatured() {
		const root = document.querySelector<HTMLElement>('[data-featured-swiper]');
		if (!root || root.classList.contains('swiper-initialized')) return;
		featuredSwiper = new Swiper(root, {
			modules: [Autoplay],
			slidesPerView: 1.2,
			spaceBetween: 30,
			loop: true,
			speed: motion.matches ? 0 : 300,
			autoplay: autoplay ? false : { delay: 4000, disableOnInteraction: false },
			keyboard: { enabled: true, onlyInViewport: true },
			breakpoints: {
				640: { slidesPerView: 2 },
				1024: { slidesPerView: 2.5 },
			},
		});
		document.querySelector('[data-featured-next]')?.addEventListener('click', () => featuredSwiper?.slideNext());
	}

	function mountSolutions() {
		const root = document.querySelector<HTMLElement>('[data-solution-swiper]');
		if (!root || root.classList.contains('swiper-initialized')) return;
		solutionSwiper = new Swiper(root, {
			modules: [Autoplay, Navigation],
			slidesPerView: 1.15,
			spaceBetween: 30,
			centeredSlides: true,
			loop: true,
			speed: motion.matches ? 0 : 300,
			autoplay: autoplay ? false : { delay: 2000, disableOnInteraction: false },
			navigation: {
				prevEl: '[data-solution-prev]',
				nextEl: '[data-solution-next]',
			},
			keyboard: { enabled: true, onlyInViewport: true },
			breakpoints: {
				768: { slidesPerView: 2 },
				1024: { slidesPerView: 3 },
			},
		});
	}

	function mountFilters() {
		const root = document.querySelector<HTMLElement>('.hx-home');
		if (!root || root.dataset.workBound === 'true') return;
		const cards = [...root.querySelectorAll<HTMLElement>('.hx-grid .hx-card')];
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-work-filter]')];
		const search = root.querySelector<HTMLInputElement>('[data-work-search]');
		const empty = root.querySelector<HTMLElement>('[data-work-empty]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-search-toggle]');
		const searchWrap = root.querySelector<HTMLElement>('.hx-search');
		if (!cards.length) return;
		root.dataset.workBound = 'true';
		let active = 'all';

		const apply = () => {
			const query = (search?.value ?? '').trim().toLowerCase();
			let shown = 0;
			cards.forEach((card) => {
				const categoryMatch = active === 'all' || card.dataset.category === active;
				const textMatch = !query || (card.dataset.text ?? '').includes(query);
				const visible = categoryMatch && textMatch;
				card.hidden = !visible;
				if (visible) shown += 1;
			});
			if (empty) empty.hidden = shown > 0;
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const next = button.dataset.workFilter ?? 'all';
				active = button.getAttribute('aria-pressed') === 'true' && next !== 'all' ? 'all' : next;
				buttons.forEach((item) => {
					const pressed = active === 'all' ? item.dataset.workFilter === 'all' : item === button && active !== 'all';
					item.setAttribute('aria-pressed', String(pressed));
				});
				apply();
			});
		});
		search?.addEventListener('input', apply);
		toggle?.addEventListener('click', () => {
			const open = searchWrap?.classList.toggle('is-open') ?? false;
			toggle.setAttribute('aria-expanded', String(open));
			if (open) search?.focus();
		});
	}

	function mountHome() {
		mountHero();
		mountFeatured();
		mountSolutions();
		mountFilters();
	}

	mountHome();
	document.addEventListener('astro:page-load', mountHome);
	document.addEventListener('astro:before-swap', () => {
		destroySwipers();
		const root = document.querySelector<HTMLElement>('.hx-home');
		if (root) delete root.dataset.workBound;
	});
</script>
