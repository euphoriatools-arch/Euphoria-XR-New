---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/studio/ContactBand.astro';
import FeedCard from '../components/studio/FeedCard.astro';
import AwardsSlider from '../components/studio/AwardsSlider.astro';
import FixedStage from '../components/studio/FixedStage.astro';
import ProcessScroll from '../components/studio/ProcessScroll.astro';
import HomeFAQ from '../components/studio/HomeFAQ.astro';
import ReviewsSlider from '../components/studio/ReviewsSlider.astro';
import WorkCard from '../components/studio/WorkCard.astro';
import { categories } from '../content/categories';
import { heroSlides } from '../data/home';
import { photos } from '../data/images';
import { loadPosts } from '../lib/blog';
import { loadProjects } from '../lib/portfolio';

const projects = await loadProjects();
const featured = projects.slice(0, 16);
const latest = projects.filter((project) => !project.data.featured).slice(0, 12);
const filters = categories.filter((category) => latest.some((project) => project.data.category === category.slug));
const posts = loadPosts();
const sandboxPosts = posts.slice(0, 8);
const newsPosts = posts.length > 8 ? posts.slice(2, 10) : [...posts].reverse();

const heroFrames = [photos.vr, photos.city, photos.abstract, photos.cosmos];
const heroVideo = 'https://euphoriaxr.com/wp-content/uploads/2026/03/Euphoria-XR-Landing-Page-Video-Euphoria-XR.mp4';
const slides = [
	{
		lines: heroSlides[0].lines,
		href: heroSlides[0].href,
		cta: heroSlides[0].cta,
		body: heroSlides[0].body,
		image: heroFrames[0],
		heading: true,
	},
	{
		lines: heroSlides[2].lines,
		href: '/ai-development-company/',
		cta: 'AI development company',
		image: heroFrames[1],
		heading: false,
	},
	{
		lines: heroSlides[1].lines,
		href: '#capabilities',
		cta: heroSlides[1].cta,
		image: heroFrames[2],
		heading: false,
	},
	{
		lines: [[{ text: 'Have a project?' }], [{ text: "We'd love to help." }]],
		href: '#contact',
		cta: 'Get in touch',
		image: heroFrames[3],
		heading: false,
	},
];

const solutions = [
	{ href: '/services/augmented-reality-development-company/', label: 'Augmented Reality', image: photos.ar },
	{ href: '/services/virtual-reality-development-company/', label: 'Virtual Reality', image: photos.vr },
	{ href: '/ai-development-company/', label: 'AI', image: photos.ai },
	{ href: '/webar-development/', label: 'WebAR', image: photos.city },
	{ href: '/product-configurator/', label: '3D Configurator', image: photos.abstract },
	{ href: '/ar-vr-training-education/', label: 'Training & Simulation', image: photos.lab },
	{ href: '/services/branded-ar-filters/', label: 'Branded AR Filters', image: photos.cosmos },
];
---

<BaseLayout
	title="AR, VR & AI Development Studio | EuphoriaXR"
	description="EuphoriaXR is an AR and VR development company creating immersive applications, interactive 3D experiences, and AI-powered solutions for businesses."
	overlayHeader
>
	<div class="hx-home">
		<section class="hx-hero-frame" aria-roledescription="carousel" aria-label="Studio">
			<video
				class="hx-hero-video"
				data-hero-video
				data-src={heroVideo}
				poster={photos.vr.src}
				muted
				playsinline
				loop
				preload="none"
				aria-hidden="true"
			></video>
			<div class="swiper" data-hero-swiper>
				<div class="swiper-wrapper">
					{
						slides.map((slide, index) => (
							<article class="swiper-slide hx-slide">
								<Image
									src={slide.image}
									alt=""
									widths={[800, 1280, 1800]}
									sizes="100vw"
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : 'low'}
								/>
								<div class="hx-slide-copy">
									{slide.heading ? (
										<h1 id="home-title" class="hx-display">
											{slide.lines.map((line) => (
												<span class="line">
													{line.map((part) => (
														<span class:list={[{ accent: part.accent }]}>{part.text}</span>
													))}
												</span>
											))}
										</h1>
									) : (
										<p class="hx-display">
											{slide.lines.map((line) => (
												<span class="line">
													{line.map((part) => (
														<span class:list={[{ accent: part.accent }]}>{part.text}</span>
													))}
												</span>
											))}
										</p>
									)}
									{slide.body ? <p class="hx-hero-lede">{slide.body}</p> : null}
									<a class="btn-primary" href={slide.href}>{slide.cta}</a>
								</div>
							</article>
						))
					}
				</div>
				<div class="swiper-pagination" data-hero-pagination></div>
			</div>
		</section>

		<section class="hx-section hx-featured" id="work" aria-labelledby="work-title">
			<div class="hx-wrap">
				<div class="hx-head">
					<h2 id="work-title">Case Studies</h2>
					<button class="hx-featured-next" type="button" data-featured-next aria-label="Next featured case study">
						<span aria-hidden="true">›</span>
					</button>
				</div>
				<div class="swiper" data-featured-swiper>
					<div class="swiper-wrapper">
						{featured.map((project) => <WorkCard project={project} slide />)}
					</div>
				</div>
			</div>
		</section>

		<section class="hx-section" aria-labelledby="latest-title">
			<div class="hx-wrap">
				<div class="hx-head">
					<h2 id="latest-title">Latest Projects</h2>
					<div class="hx-tools">
						<label class="hx-search" for="work-search">
							<span class="sr-only">Search work</span>
							<input id="work-search" type="search" placeholder="Search" data-work-search autocomplete="off" />
							<button class="hx-search-btn" type="button" data-search-toggle aria-label="Focus search">
								<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
									<circle cx="11" cy="11" r="6.5" />
									<path d="m16.2 16.2 3.3 3.3" stroke-linecap="round" />
								</svg>
							</button>
						</label>
						<a class="hx-view-all" href="/portfolio/">View All</a>
					</div>
				</div>
				<div class="hx-filters" role="toolbar" aria-label="Filter work">
					<button type="button" data-work-filter="all" aria-pressed="true">All</button>
					{
						filters.map((category) => (
							<button type="button" data-work-filter={category.slug} aria-pressed="false">{category.tab}</button>
						))
					}
				</div>
				<div class="hx-grid">
					{latest.map((project) => <WorkCard project={project} />)}
				</div>
				<p class="hx-empty" data-work-empty hidden>Nothing matches that filter.</p>
			</div>
		</section>

		<AwardsSlider />

		<section class="hx-section hx-solutions" id="capabilities" aria-labelledby="solutions-title">
			<div class="hx-wrap">
				<h2 id="solutions-title">Solutions and Capabilities</h2>
				<div class="hx-solutions-banner">
					<Image
						src={photos.abstract}
						alt=""
						widths={[800, 1280, 1800]}
						sizes="100vw"
						loading="lazy"
					/>
					<p>EuphoriaXR combines creative design, 3D production, and advanced technology to build custom AR, VR, and AI experiences for global brands and enterprises.</p>
				</div>
				<div class="swiper" data-solution-swiper>
					<div class="swiper-wrapper">
						{
							solutions.map((item) => (
								<a class="swiper-slide hx-solution" href={item.href}>
									<span class="hx-solution-media">
										<Image src={item.image} alt="" widths={[320, 480]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" loading="lazy" />
									</span>
									<span class="hx-solution-label">{item.label}</span>
								</a>
							))
						}
					</div>
				</div>
				<div class="hx-solution-nav">
					<p class="hx-caption">Each of these is a service we already ship, from the first prototype through launch.</p>
					<div>
						<button class="hx-icon-btn" type="button" data-solution-prev aria-label="Previous solution">‹</button>
						<button class="hx-icon-btn" type="button" data-solution-next aria-label="Next solution">›</button>
					</div>
				</div>
			</div>
		</section>

		<ProcessScroll />

		<FixedStage
			titleLead="Why Choose"
			titleBrand="Euphoria"
			titleTail="for AR & VR Development?"
			body="We pair bold creative thinking with proven AR and VR engineering to build experiences that work beyond the demo. From immersive training to interactive product visualization, we deliver practical solutions for ambitious brands and enterprises."
		/>

		{
			sandboxPosts.length > 0 && (
				<section class="hx-section hx-feed" id="sandbox" aria-labelledby="sandbox-title">
					<div class="hx-wrap">
						<div class="hx-head">
							<h2 id="sandbox-title">Insights and Technology Trends</h2>
							<a class="hx-view-all" href="/exr-blogs/">View All</a>
						</div>
						<div class="swiper" data-sandbox-swiper>
							<div class="swiper-wrapper">
								{sandboxPosts.map((post) => <FeedCard post={post} slide />)}
							</div>
						</div>
					</div>
				</section>
			)
		}

		{
			newsPosts.length > 0 && (
				<section class="hx-section hx-feed" id="news" aria-labelledby="news-title">
					<div class="hx-wrap">
						<div class="hx-head">
							<h2 id="news-title">EuphoriaXR News, Awards &amp; Recognition</h2>
							<a class="hx-view-all" href="/exr-blogs/">View All</a>
						</div>
						<div class="swiper" data-news-swiper>
							<div class="swiper-wrapper">
								{newsPosts.map((post) => <FeedCard post={post} slide />)}
							</div>
						</div>
					</div>
				</section>
			)
		}

		<ReviewsSlider />
		<HomeFAQ />
	</div>
	<ContactBand />
</BaseLayout>

<script>
	import Swiper from 'swiper';
	import { Autoplay, Navigation, Pagination } from 'swiper/modules';

	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	const autoplay = motion.matches || saveData;

	let hero: Swiper | undefined;
	let featuredSwiper: Swiper | undefined;
	let solutionSwiper: Swiper | undefined;
	let sandboxSwiper: Swiper | undefined;
	let newsSwiper: Swiper | undefined;

	function destroySwipers() {
		hero?.destroy(true, true);
		featuredSwiper?.destroy(true, true);
		solutionSwiper?.destroy(true, true);
		sandboxSwiper?.destroy(true, true);
		newsSwiper?.destroy(true, true);
		hero = undefined;
		featuredSwiper = undefined;
		solutionSwiper = undefined;
		sandboxSwiper = undefined;
		newsSwiper = undefined;
	}

	function mountHero() {
		const root = document.querySelector<HTMLElement>('[data-hero-swiper]');
		if (!root || root.classList.contains('swiper-initialized')) return;
		hero = new Swiper(root, {
			modules: [Autoplay, Pagination],
			slidesPerView: 1,
			loop: true,
			speed: motion.matches ? 0 : 300,
			autoplay: autoplay ? false : { delay: 6000, disableOnInteraction: false },
			pagination: {
				el: '[data-hero-pagination]',
				clickable: true,
			},
			keyboard: { enabled: true, onlyInViewport: true },
			on: {
				init(swiper) {
					const titles = root.querySelectorAll('#home-title');
					titles.forEach((title, index) => {
						if (index > 0) title.removeAttribute('id');
					});
					bindHeroVideo(swiper);
				},
				slideChange(swiper) {
					syncHeroVideo(swiper.realIndex);
				},
			},
		});
	}

	function syncHeroVideo(index: number) {
		const frame = document.querySelector<HTMLElement>('.hx-hero-frame');
		const video = frame?.querySelector<HTMLVideoElement>('[data-hero-video]');
		if (!frame || !video) return;
		const allow = !(motion.matches || saveData);
		const onFirst = index === 0 && allow;
		if (!allow) {
			frame.classList.remove('is-playing');
			video.removeAttribute('src');
			video.pause();
			return;
		}
		if (!video.getAttribute('src') && video.dataset.src) {
			video.preload = 'auto';
			video.src = video.dataset.src;
		}
		const live = onFirst && !video.paused && video.currentTime > 0;
		frame.classList.toggle('is-playing', live);
		if (onFirst) video.play()?.catch(() => {});
		else video.pause();
	}

	function bindHeroVideo(swiper: Swiper) {
		const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
		const show = () => syncHeroVideo(swiper.realIndex);
		video?.addEventListener('playing', show);
		video?.addEventListener('timeupdate', show);
		show();
	}

	function mountFeatured() {
		const root = document.querySelector<HTMLElement>('[data-featured-swiper]');
		if (!root || root.classList.contains('swiper-initialized')) return;
		featuredSwiper = new Swiper(root, {
			modules: [Autoplay],
			slidesPerView: 1.2,
			spaceBetween: 30,
			loop: true,
			speed: motion.matches ? 0 : 300,
			autoplay: autoplay ? false : { delay: 4000, disableOnInteraction: false },
			keyboard: { enabled: true, onlyInViewport: true },
			breakpoints: {
				640: { slidesPerView: 2 },
				1024: { slidesPerView: 2.5 },
			},
		});
		document.querySelector('[data-featured-next]')?.addEventListener('click', () => featuredSwiper?.slideNext());
	}

	function mountSolutions() {
		const root = document.querySelector<HTMLElement>('[data-solution-swiper]');
		if (!root || root.classList.contains('swiper-initialized')) return;
		solutionSwiper = new Swiper(root, {
			modules: [Autoplay, Navigation],
			slidesPerView: 1.2,
			spaceBetween: 16,
			loop: true,
			speed: motion.matches ? 0 : 300,
			autoplay: autoplay ? false : { delay: 2800, disableOnInteraction: false, pauseOnMouseEnter: true },
			navigation: {
				prevEl: '[data-solution-prev]',
				nextEl: '[data-solution-next]',
			},
			keyboard: { enabled: true, onlyInViewport: true },
			breakpoints: {
				640: { slidesPerView: 2, spaceBetween: 20 },
				1024: { slidesPerView: 3, spaceBetween: 24 },
			},
		});
	}

	function mountFeed(selector: string, assign: (swiper: Swiper) => void) {
		const root = document.querySelector<HTMLElement>(selector);
		if (!root || root.classList.contains('swiper-initialized')) return;
		assign(
			new Swiper(root, {
				modules: [Autoplay],
				slidesPerView: 1.15,
				spaceBetween: 16,
				loop: !motion.matches && (root.querySelectorAll('.swiper-slide').length >= 4),
				speed: motion.matches ? 0 : 300,
				autoplay: autoplay ? false : { delay: 4500, disableOnInteraction: false, pauseOnMouseEnter: true },
				keyboard: { enabled: true, onlyInViewport: true },
				breakpoints: {
					640: { slidesPerView: 2, spaceBetween: 20 },
					1024: { slidesPerView: 3, spaceBetween: 24 },
				},
			}),
		);
	}

	function mountFilters() {
		const root = document.querySelector<HTMLElement>('.hx-home');
		if (!root || root.dataset.workBound === 'true') return;
		const cards = [...root.querySelectorAll<HTMLElement>('.hx-grid .hx-card')];
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-work-filter]')];
		const search = root.querySelector<HTMLInputElement>('[data-work-search]');
		const empty = root.querySelector<HTMLElement>('[data-work-empty]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-search-toggle]');
		if (!cards.length) return;
		root.dataset.workBound = 'true';
		let active = 'all';

		const apply = () => {
			const query = (search?.value ?? '').trim().toLowerCase();
			let shown = 0;
			cards.forEach((card) => {
				const categoryMatch = active === 'all' || card.dataset.category === active;
				const textMatch = !query || (card.dataset.text ?? '').includes(query);
				const visible = categoryMatch && textMatch;
				card.hidden = !visible;
				if (visible) shown += 1;
			});
			if (empty) empty.hidden = shown > 0;
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const next = button.dataset.workFilter ?? 'all';
				active = button.getAttribute('aria-pressed') === 'true' && next !== 'all' ? 'all' : next;
				buttons.forEach((item) => {
					const pressed = active === 'all' ? item.dataset.workFilter === 'all' : item === button && active !== 'all';
					item.setAttribute('aria-pressed', String(pressed));
				});
				apply();
			});
		});
		search?.addEventListener('input', apply);
		toggle?.addEventListener('click', () => {
			search?.focus();
		});
	}

	function mountHome() {
		mountHero();
		mountFeatured();
		mountSolutions();
		mountFeed('[data-sandbox-swiper]', (swiper) => {
			sandboxSwiper = swiper;
		});
		mountFeed('[data-news-swiper]', (swiper) => {
			newsSwiper = swiper;
		});
		mountFilters();
	}

	mountHome();
	document.addEventListener('astro:page-load', mountHome);
	document.addEventListener('astro:before-swap', () => {
		destroySwipers();
		const root = document.querySelector<HTMLElement>('.hx-home');
		if (root) delete root.dataset.workBound;
	});
</script>
