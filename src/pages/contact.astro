---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import CaseCard from '../components/portfolio/CaseCard.astro';
import { formatAddress, site } from '../config/site';
import { clientLogos } from '../data/clients';
import { breadcrumbSchema } from '../lib/schema';
import { loadProjects } from '../lib/portfolio';
import '../styles/case.css';
import '../styles/contact.css';

const title = 'Contact EuphoriaXR | Start an Immersive Project Today';
const description =
	'Contact EuphoriaXR to start an AR, VR, AI, or 3D project. Tell us the audience, the constraint, and the date, and we will reply with a way to begin.';
const crumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Contact', href: '/contact/' },
];
const address = formatAddress();
const usa = site.offices.find((office) => office.id === 'usa') ?? site.offices[0];
const uk = site.offices.find((office) => office.id === 'uk');
const mapQuery = encodeURIComponent(usa.mapQuery);
const mapEmbed = `https://maps.google.com/maps?q=${mapQuery}&z=15&ie=UTF8&iwloc=&output=embed`;
const mapOpen = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const logos = clientLogos;

const social = [
	{
		href: site.social.facebook,
		label: 'Facebook',
		path: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1Z',
	},
	{
		href: site.social.linkedin,
		label: 'LinkedIn',
		path: 'M4.7 3.3A1.8 1.8 0 1 0 4.7 7a1.8 1.8 0 0 0 0-3.7ZM3.2 8.6h3V21h-3V8.6Zm5.1 0h2.9v1.7h.1c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.7 2 3.7 4.7V21h-3v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-3V8.6Z',
	},
	{
		href: site.social.instagram,
		label: 'Instagram',
		path: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9A4.5 4.5 0 0 1 16.5 21h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.7A2.8 2.8 0 0 0 4.7 7.5v9A2.8 2.8 0 0 0 7.5 19.3h9a2.8 2.8 0 0 0 2.8-2.8v-9a2.8 2.8 0 0 0-2.8-2.8h-9Zm9.2 1.4a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1ZM12 7.4A4.6 4.6 0 1 1 7.4 12 4.6 4.6 0 0 1 12 7.4Zm0 1.7A2.9 2.9 0 1 0 14.9 12 2.9 2.9 0 0 0 12 9.1Z',
	},
	{
		href: site.social.x,
		label: 'X',
		path: 'M14.7 10.3 22 2h-2.2l-6.1 7-4.9-7H2.2l7.7 11.1L2 22h2.2l6.7-7.7 5.3 7.7h6.6l-8.1-11.7Zm-2.4 2.7-.8-1.1L5.2 3.6h2.7l5 7.1.8 1.1 6.5 9.2h-2.7l-5.2-7z',
	},
	{
		href: site.social.youtube,
		label: 'YouTube',
		path: 'M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C17.9 5 12 5 12 5s-5.9 0-7.7.3A2.7 2.7 0 0 0 2.4 7.2 28.6 28.6 0 0 0 2 12a28.6 28.6 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9C6.1 19 12 19 12 19s5.9 0 7.7-.3a2.7 2.7 0 0 0 1.9-1.9A28.6 28.6 0 0 0 22 12a28.6 28.6 0 0 0-.4-4.8ZM10 15.2V8.8L15.5 12 10 15.2Z',
	},
];

const featured = (await loadProjects())
	.slice()
	.sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
	.slice(0, 8);
---

<BaseLayout title={title} description={description} overlayHeader jsonLd={[breadcrumbSchema(crumbs)]}>
	<div class="cx">
		<section class="cx-hero" aria-labelledby="contact-title">
			<div class="cx-hero-row">
				<div class="cx-intro">
					<Breadcrumbs items={crumbs} />
					<h1 id="contact-title">Connect with Us</h1>
					<p class="cx-lead" data-reveal>
						We would love to hear from you. Share your production needs with us, or drop a note to say hello. Whether you are envisioning something bold or seeking inspiration for AR, VR, AI, or innovative interactive experiences, our team of experts can support you every step of the way.
					</p>
					<ul class="cx-contact-list" data-reveal>
						<li>Phone <a href={`tel:${usa.phone.replace(/\s/g, '')}`}>{usa.phone}</a></li>
						<li>Email <a href={`mailto:${site.email}`}>{site.email}</a></li>
						<li><address>{address}</address></li>
					</ul>
				</div>
				<div class="cx-panel">
					<ContactForm layout="panel" />
				</div>
			</div>
		</section>

		<section class="cx-mapband" aria-label="Studio location and contact">
			<div class="cx-map">
				<iframe
					title="EuphoriaXR office on Google Maps"
					src={mapEmbed}
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen
				></iframe>
				<a class="cx-map-open" href={mapOpen} target="_blank" rel="noopener noreferrer">
					Open in Maps
					<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</div>
			<div class="cx-map-panel">
				<p class="cx-map-brand" aria-hidden="true">
					<span>EUPHORIA</span><span class="cx-map-brand-xr"> XR</span>
				</p>
				<ul class="cx-map-list">
					<li>
						<span class="cx-map-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M6.6 10.8c1.2 2.4 3.2 4.4 5.6 5.6l1.9-1.9c.2-.2.6-.3.9-.2 1 .3 2 .5 3.1.5.5 0 .9.4.9.9V19c0 .5-.4.9-.9.9C10.5 19.9 4.1 13.5 4.1 5.9c0-.5.4-.9.9-.9H8c.5 0 .9.4.9.9 0 1.1.2 2.1.5 3.1.1.3 0 .6-.2.9l-1.6 1.9Z" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
						<a href={`tel:${usa.phone.replace(/\s/g, '')}`}>{usa.phone}</a>
					</li>
					{
						uk && (
							<li>
								<span class="cx-map-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
										<path d="M6.6 10.8c1.2 2.4 3.2 4.4 5.6 5.6l1.9-1.9c.2-.2.6-.3.9-.2 1 .3 2 .5 3.1.5.5 0 .9.4.9.9V19c0 .5-.4.9-.9.9C10.5 19.9 4.1 13.5 4.1 5.9c0-.5.4-.9.9-.9H8c.5 0 .9.4.9.9 0 1.1.2 2.1.5 3.1.1.3 0 .6-.2.9l-1.6 1.9Z" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<a href={`tel:${uk.phone.replace(/\s/g, '')}`}>{uk.phone}</a>
							</li>
						)
					}
					<li>
						<span class="cx-map-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11Z" />
								<path d="m5 7 7 5 7-5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
						<a href={`mailto:${site.email}`}>{site.email}</a>
					</li>
					<li>
						<span class="cx-map-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" />
								<circle cx="12" cy="10" r="2.5" />
							</svg>
						</span>
						<address>{address}</address>
					</li>
				</ul>
				<div class="cx-map-socials">
					{
						social.map((link) => (
							<a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
								<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" width="16" height="16">
									<path d={link.path} />
								</svg>
								<span class="sr-only">{link.label} (opens in a new tab)</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="cx-clients" aria-labelledby="cx-clients-title">
			<div class="cx-clients-wrap">
				<h2 id="cx-clients-title">Clients</h2>
				<ul class="cx-logo-grid">
					{
						logos.map((logo) => (
							<li>
								<img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
							</li>
						))
					}
				</ul>
			</div>
		</section>

		{
			featured.length > 0 && (
				<section class="cs-related cx-work" aria-roledescription="carousel" aria-labelledby="featured-work-title">
					<div class="cs-related-head">
						<h2 id="featured-work-title">Featured Case Studies</h2>
						{featured.length >= 3 && (
							<button class="cs-related-next" type="button" data-cx-next aria-label="Next case study">
								›
							</button>
						)}
					</div>
					<div class={featured.length >= 3 ? 'swiper' : 'cs-grid cs-wrap'} data-cx-featured={featured.length >= 3 ? 'swiper' : 'static'}>
						<div class={featured.length >= 3 ? 'swiper-wrapper' : undefined}>
							{featured.map((project) => (
								<div class={featured.length >= 3 ? 'swiper-slide' : undefined}>
									<CaseCard project={project} />
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}
	</div>
	<script>
		import Swiper from 'swiper';
		import { Autoplay, Navigation } from 'swiper/modules';

		let featuredSwiper: Swiper | undefined;

		function bindFeatured() {
			featuredSwiper?.destroy(true, true);
			featuredSwiper = undefined;
			const root = document.querySelector<HTMLElement>('[data-cx-featured="swiper"]');
			if (!root) return;
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			featuredSwiper = new Swiper(root, {
				modules: [Autoplay, Navigation],
				slidesPerView: 1.2,
				spaceBetween: 16,
				speed: 300,
				loop: !reduce,
				autoplay: reduce ? false : { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
				navigation: { nextEl: '[data-cx-next]' },
				breakpoints: {
					768: { slidesPerView: 2.2, spaceBetween: 24 },
					1024: { slidesPerView: 2.5, spaceBetween: 30 },
				},
			});
		}

		bindFeatured();
		document.addEventListener('astro:page-load', () => bindFeatured());
		document.addEventListener('astro:before-swap', () => {
			featuredSwiper?.destroy(true, true);
			featuredSwiper = undefined;
		});
	</script>
</BaseLayout>
