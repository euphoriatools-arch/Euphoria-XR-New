---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { site } from '../config/site';
import { breadcrumbSchema } from '../lib/schema';

const title = 'Privacy Policy | How EuphoriaXR Handles Personal Data';
const description =
	'Read how EuphoriaXR handles contact details, site analytics, and project files. This policy explains what we collect, why, and how to reach us about your data.';
const crumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Privacy policy', href: '/privacy-policy/' },
];
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbSchema(crumbs)]}>
	<section class="section">
		<div class="section-inner legal">
			<Breadcrumbs items={crumbs} />
			<h1>Privacy policy</h1>
			<p>This policy describes how {site.siteName} handles personal information on this website and in project conversations. It is written for visitors and prospective clients. It is not a substitute for advice from your own counsel.</p>
			<!-- TODO: Have counsel review this policy before launch, and add the real business address. -->
			<h2>What we collect</h2>
			<p>If you email {site.email} or use the contact form, we receive the name, email, company, service interest, and message you submit. Server logs may also store a technical record of the request, such as the time and the browser, for security.</p>
			<h2>Why we use it</h2>
			<p>We use that information to reply, to scope a project, and to keep a record of the conversation. We do not sell contact details. We do not use the form contents to train public models.</p>
			<h2>How long we keep it</h2>
			<p>We keep inquiry records for as long as the conversation is active and for a reasonable period afterward so we can answer follow-ups. You can ask us to delete an inquiry that has not become a contract.</p>
			<h2>Processors</h2>
			<p>If we connect the form to an email or CRM provider, that provider processes the submission on our instructions. The provider will be named in this policy when it is connected. Until then, the form validates your note and asks you to email us directly.</p>
			<h2>Contact</h2>
			<p>Questions about this policy go to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
		</div>
	</section>
</BaseLayout>
