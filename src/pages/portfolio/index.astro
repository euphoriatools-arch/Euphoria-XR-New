---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBand from '../../components/studio/ContactBand.astro';
import CaseCard from '../../components/portfolio/CaseCard.astro';
import PortfolioImage from '../../components/portfolio/PortfolioImage.astro';
import { categories } from '../../content/categories';
import { photos } from '../../data/images';
import { loadProjects } from '../../lib/portfolio';
import { assertMeta } from '../../lib/seo';
import { breadcrumbSchema } from '../../lib/schema';
import '../../styles/case.css';

const title = 'Portfolio of Immersive AR, VR, and AI Work | EuphoriaXR';
const description =
	'Browse sample EuphoriaXR projects in augmented reality, virtual reality, 360 video, blockchain, and artificial intelligence. Filter by category.';
assertMeta('Portfolio index', title, description);

const projects = await loadProjects();
const crumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Case studies', href: '/portfolio/' },
];
---

<BaseLayout title={title} description={description} overlayHeader jsonLd={[breadcrumbSchema(crumbs)]}>
	<div class="cs-list">
		<section class="cs-hero-frame" aria-labelledby="portfolio-title">
			<PortfolioImage
				src={photos.vr}
				alt="Person wearing a virtual reality headset with both arms raised"
				width={photos.vr.width}
				height={photos.vr.height}
				widths={[800, 1400]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="cs-hero-copy">
				<h1 id="portfolio-title">Case Studies.</h1>
			</div>
		</section>

		<section class="cs-work" aria-labelledby="latest-work-title">
			<div class="cs-work-head">
				<h2 id="latest-work-title">Latest Work</h2>
				<form class="cs-search" role="search" data-cs-search>
					<label class="sr-only" for="case-search">Search</label>
					<input id="case-search" type="search" placeholder="Search" autocomplete="off" />
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="M20 20l-3.5-3.5"></path>
					</svg>
				</form>
			</div>
			<nav class="cs-filters" aria-label="Case study categories">
				<a href="/portfolio/" aria-current="page">All</a>
				{categories.map((category) => <a href={`/portfolio/${category.slug}/`}>{category.tab}</a>)}
			</nav>
			<div class="cs-grid">
				{projects.map((project, index) => <CaseCard project={project} eager={index < 3} />)}
			</div>
			<div class="cs-empty" data-cs-empty>
				<h2>No projects match yet.</h2>
				<button type="button" data-cs-clear>Clear filters</button>
			</div>
		</section>
	</div>
	<ContactBand />
	<script>
		function bindCaseSearch() {
			const form = document.querySelector<HTMLFormElement>('[data-cs-search]');
			const input = form?.querySelector<HTMLInputElement>('input');
			const empty = document.querySelector<HTMLElement>('[data-cs-empty]');
			const cards = [...document.querySelectorAll<HTMLElement>('[data-cs-card]')];
			if (!form || !input || !empty || cards.length === 0) return;

			const apply = () => {
				const query = input.value.trim().toLowerCase();
				let shown = 0;
				for (const card of cards) {
					const title = (card.dataset.title ?? '').toLowerCase();
					const match = query.length === 0 || title.includes(query);
					card.classList.toggle('is-hidden', !match);
					if (match) shown += 1;
				}
				empty.classList.toggle('is-visible', shown === 0);
			};

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				apply();
			});
			input.addEventListener('input', apply);
			input.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					input.value = '';
					apply();
				}
			});
			document.querySelector('[data-cs-clear]')?.addEventListener('click', () => {
				input.value = '';
				apply();
				input.focus();
			});
		}

		bindCaseSearch();
		document.addEventListener('astro:page-load', () => bindCaseSearch());
	</script>
</BaseLayout>
