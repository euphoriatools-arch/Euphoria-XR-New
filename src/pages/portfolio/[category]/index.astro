---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactBand from '../../../components/studio/ContactBand.astro';
import CaseCard from '../../../components/portfolio/CaseCard.astro';
import PortfolioImage from '../../../components/portfolio/PortfolioImage.astro';
import { categories, categoryBySlug } from '../../../content/categories';
import { photoFor } from '../../../data/images';
import { loadProjects, projectsInCategory } from '../../../lib/portfolio';
import { breadcrumbSchema } from '../../../lib/schema';
import '../../../styles/case.css';

export function getStaticPaths() {
	return categories.map((category) => ({
		params: { category: category.slug },
	}));
}

const category = categoryBySlug(Astro.params.category ?? '');
if (!category) throw new Error(`Unknown portfolio category: ${Astro.params.category}`);
const hero = photoFor(category.hero);
const projects = projectsInCategory(await loadProjects(), category.slug);
const crumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Case studies', href: '/portfolio/' },
	{ name: category.name, href: `/portfolio/${category.slug}/` },
];
---

<BaseLayout title={category.seo.title} description={category.seo.description} overlayHeader jsonLd={[breadcrumbSchema(crumbs)]}>
	<div class="cs-category">
		<section class="cs-hero-frame" aria-labelledby="category-title">
			<PortfolioImage
				src={hero}
				alt={category.heroAlt}
				width={hero.width}
				height={hero.height}
				widths={[800, 1400]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="cs-hero-copy">
				<h1 id="category-title">{category.name}</h1>
			</div>
		</section>
		<section class="cs-work" aria-labelledby="category-work-title">
			<div class="cs-work-head">
				<h2 id="category-work-title">Latest Work</h2>
			</div>
			<nav class="cs-filters" aria-label="Case study categories">
				<a href="/portfolio/">All</a>
				{
					categories.map((item) => (
						<a href={`/portfolio/${item.slug}/`} aria-current={item.slug === category.slug ? 'page' : undefined}>
							{item.tab}
						</a>
					))
				}
			</nav>
			<div class="cs-grid">
				{projects.map((project, index) => <CaseCard project={project} eager={index < 3} />)}
			</div>
		</section>
		<section class="cs-benefits" aria-labelledby="category-why-title">
			<h2 id="category-why-title">Why teams ask for this</h2>
			<p class="cs-benefits-lead">{category.intro}</p>
			<ul>
				{
					category.benefits.map((benefit) => (
						<li>
							<h3>{benefit.title}</h3>
							<p>{benefit.body}</p>
						</li>
					))
				}
			</ul>
		</section>
	</div>
	<ContactBand />
</BaseLayout>
