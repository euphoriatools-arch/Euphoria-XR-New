---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ContactBand from '../components/studio/ContactBand.astro';
import { photos, photoFor } from '../data/images';
import { servicePages } from '../data/services';
import { studioGroups, platformSlugs } from '../data/studio-links';
import { breadcrumbSchema } from '../lib/schema';

const title = 'About EuphoriaXR | Creative Technology Studio Team';
const description =
	'EuphoriaXR is a creative technology studio. Meet the practice behind our AR, VR, AI, and 3D work, from the first prototype through launch day.';
const crumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'About', href: '/about/' },
];

const platforms = platformSlugs.map((slug) => {
	const page = servicePages.find((item) => item.slug === slug);
	const label = studioGroups.flatMap((group) => group.links).find((link) => link.href === `/${slug}/`)?.label;
	if (!page || !label) throw new Error(`Missing platform page: ${slug}`);
	return { page, label };
});

const shots = [
	{ src: photos.lab, alt: 'Engineer working on a laptop inside a technical assembly bay' },
	{ src: photos.vr, alt: 'Person wearing a virtual reality headset with both arms raised' },
	{ src: photos.abstract, alt: '' },
	{ src: photos.city, alt: 'A city street at night' },
];
---

<BaseLayout title={title} description={description} overlayHeader jsonLd={[breadcrumbSchema(crumbs)]}>
	<div class="hx-about">
		<div class="hx-about-crumbs">
			<Breadcrumbs items={crumbs} />
		</div>

		<section class="hx-about-hero" aria-labelledby="about-title">
			<div class="hx-about-frame">
				<Image
					src={photos.vr}
					alt=""
					widths={[800, 1280, 1800]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="hx-about-top" aria-hidden="true"></div>
				<div class="hx-about-copy">
					<h1 id="about-title">A creative technology studio for immersive experiences.</h1>
					<p class="hx-about-lede">We design, build and deliver AR, VR, mixed reality and interactive experiences that connect people, brands and ideas in the real world.</p>
				</div>
			</div>
		</section>

		<div class="hx-about-col">
			<h2 data-reveal>We are a creative technology studio.</h2>
			<p data-reveal>EuphoriaXR brings together immersive design, engineering and storytelling to transform ideas into interactive experiences. We believe technology is most powerful when it helps people learn, explore and connect.</p>
			<figure class="hx-about-shot" data-reveal>
				<Image src={shots[0].src} alt={shots[0].alt} widths={[640, 1024]} sizes="(min-width: 1024px) 1024px, 100vw" loading="lazy" />
			</figure>
			<p data-reveal>From the first creative concept through development and deployment, our multidisciplinary approach blends imagination with technical craft.</p>
			<figure class="hx-about-shot" data-reveal>
				<Image src={shots[1].src} alt={shots[1].alt} widths={[640, 1024]} sizes="(min-width: 1024px) 1024px, 100vw" loading="lazy" />
			</figure>
			<p data-reveal>AR, VR, AI, WebXR, and 3D experiences. Typical work includes training simulations, campaign WebAR, product configurators, chatbots, and agents that sit inside a product you already run.</p>
			<figure class="hx-about-shot" data-reveal>
				<Image src={shots[2].src} alt={shots[2].alt} widths={[640, 1024]} sizes="(min-width: 1024px) 1024px, 100vw" loading="lazy" />
			</figure>

			<h2 id="approach-title" data-reveal>Why we prototype before we produce.</h2>
			<p data-reveal>We write the user, the job, and the constraint before we pick a tool. A prototype you can hold, wear, or click is reviewed against the real context.</p>
			<p data-reveal>When an experience has to answer, adapt, or score. A training sim can record a procedure. A WebAR scene can explain a product from approved sources. We do not add a model unless it has a job.</p>
			<p class="hx-about-more" data-reveal>Learn more about <a href="/ai-development-company/">AI development company</a></p>
			<p class="hx-about-sub" data-reveal>A prototype scoped to answer one question, then a production release.</p>
			<figure class="hx-about-shot" data-reveal>
				<Image src={shots[3].src} alt={shots[3].alt} widths={[640, 1024]} sizes="(min-width: 1024px) 1024px, 100vw" loading="lazy" />
			</figure>

			<p data-reveal>Experiences people can use, from a phone scan to a headset rehearsal.</p>
			<h2 class="is-sub" id="platforms-title" data-reveal>Platforms we already ship.</h2>
			<ul class="hx-about-cards">
				{
					platforms.map(({ page, label }) => (
						<li data-reveal>
							<a href={`/${page.slug}/`}>
								<Image
									src={photoFor(page.image)}
									alt=""
									widths={[480, 800]}
									sizes="(min-width: 1024px) 488px, 100vw"
									loading="lazy"
								/>
								<p>{page.serviceType}</p>
								<h3>{label}</h3>
								<span>{page.summary}</span>
							</a>
						</li>
					))
				}
			</ul>

			<section class="hx-about-services" aria-labelledby="services-title">
				<h3 id="services-title" data-reveal>Our Services</h3>
				<p data-reveal>The work we take on spans conversation, spatial computing, training, and the campaigns that have to open on a phone.</p>
				<div class="hx-about-groups">
					{
						studioGroups.map((group, index) => (
							<section data-reveal aria-labelledby={`service-group-${index}`}>
								<h4 id={`service-group-${index}`}>
									<a href={group.links[0].href}>{group.title}</a>
								</h4>
								<ul>
									{group.links.map((link) => (
										<li>
											<a href={link.href}>{link.label}</a>
										</li>
									))}
								</ul>
							</section>
						))
					}
				</div>
			</section>
		</div>
	</div>
	<ContactBand id="about-contact-title" compact />
</BaseLayout>
